fig_cust.update_layout(**B, margin=dict(l=8, r=50, t=28, b=8),
    title=dict(text='Top 10 Customers by Profit', font=dict(size=10, color=SLATE), x=0))
fig_cust.update_xaxes(**xa(), tickprefix='$')
fig_cust.update_yaxes(gridcolor='rgba(0,0,0,0)', linecolor=BORDER, tickfont=dict(color=SLATE, size=8), showgrid=False)

# ── PAGE 4 CHARTS ──────────────────────────────────────────────────────────────
fig_ship = go.Figure()
fig_ship.add_trace(go.Bar(x=ship['Ship Mode'], y=ship['orders'],
    marker=dict(color=BLUE, opacity=0.8, line_width=0), name='Orders', yaxis='y', width=0.4))
fig_ship.add_trace(go.Scatter(x=ship['Ship Mode'], y=ship['avg_sale'],
    mode='lines+markers', name='Avg Sale',
    line=dict(color=AMBER, width=2), marker=dict(size=6, color=AMBER), yaxis='y2'))
fig_ship.update_layout(**B, margin=DM,
    title=dict(text='Ship Mode — Volume vs Avg Sale', font=dict(size=10, color=SLATE), x=0),
    yaxis=dict(gridcolor=BORDER, linecolor=BORDER, tickfont=dict(color=GRAY, size=8), showgrid=True),
    yaxis2=dict(overlaying='y', side='right', tickfont=dict(color=AMBER, size=8), tickprefix='$', showgrid=False),
    legend=dict(orientation='h', y=1.18, x=1, xanchor='right', font=dict(size=8)),
    xaxis=dict(gridcolor=BORDER, linecolor=BORDER, tickfont=dict(color=SLATE, size=8), showgrid=False),
    bargap=0.4)

fig_risk = go.Figure(go.Pie(
    labels=risk['risk'], values=risk['count'], hole=0.55,
    marker=dict(colors=[RED, GREEN], line=dict(color=WHITE, width=2)),
    textinfo='percent+label', textfont=dict(size=9)))
fig_risk.update_layout(**B, margin=DM, showlegend=False,
    title=dict(text='Discount Risk', font=dict(size=10, color=SLATE), x=0))

fig_run = go.Figure(go.Scatter(
    x=running['Month'], y=running['cumulative'],
    fill='tozeroy', fillcolor='rgba(5,150,105,0.08)',
