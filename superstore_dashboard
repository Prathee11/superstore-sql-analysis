def switch_page(n1, n2, n3, n4):
    ctx = dash.callback_context
    active = '1' if not ctx.triggered else ctx.triggered[0]['prop_id'].split('.')[0].split('-')[1]
    pc = {str(i): f'page p{i}{" active" if str(i)==active else ""}' for i in range(1,5)}
    nc = {str(i): f'nav-btn{" active" if str(i)==active else ""}' for i in range(1,5)}
    return pc['1'],pc['2'],pc['3'],pc['4'],nc['1'],nc['2'],nc['3'],nc['4']

