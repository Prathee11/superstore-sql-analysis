import dash
from dash import dcc, html, Input, Output
import plotly.graph_objects as go
import pandas as pd

# ── Load & Prepare ─────────────────────────────────────────────────────────────
df = pd.read_csv('orders.csv')
df['Order Date'] = pd.to_datetime(df['Order Date'])
df['Ship Date']  = pd.to_datetime(df['Ship Date'])
df['Month']      = df['Order Date'].dt.to_period('M').astype(str)
df['Year']       = df['Order Date'].dt.year
df['Quarter']    = df['Order Date'].dt.to_period('Q').astype(str)

# ── KPIs ───────────────────────────────────────────────────────────────────────
total_sales     = df['Sales'].sum()
total_profit    = df['Profit'].sum()
profit_margin   = total_profit / total_sales * 100
total_orders    = df['Order ID'].nunique()
total_customers = df['Customer ID'].nunique()
avg_order_val   = df.groupby('Order ID')['Sales'].sum().mean()

# ── Aggregations ───────────────────────────────────────────────────────────────
monthly  = df.groupby('Month').agg(sales=('Sales','sum'), profit=('Profit','sum')).round(2).reset_index()
yearly   = df.groupby('Year').agg(sales=('Sales','sum')).round(2).reset_index()
cat      = df.groupby('Category').agg(sales=('Sales','sum'), profit=('Profit','sum')).round(2).reset_index()
subcat   = df.groupby('Sub-Category').agg(profit=('Profit','sum'), sales=('Sales','sum')).round(2).reset_index().sort_values('profit')
reg      = df.groupby('Region').agg(sales=('Sales','sum'), profit=('Profit','sum')).round(2).reset_index()
seg      = df.groupby('Segment').agg(sales=('Sales','sum')).round(2).reset_index()
ship     = df.groupby('Ship Mode').agg(orders=('Order ID','nunique'), avg_sale=('Sales','mean')).round(2).reset_index()
top_cust = df.groupby('Customer Name').agg(profit=('Profit','sum')).round(2).reset_index().nlargest(10,'profit')
df['risk']= df['Discount'].apply(lambda x: 'High Risk' if x >= 0.5 else 'Safe')
risk     = df.groupby('risk').size().reset_index(name='count')
qreg     = df.groupby(['Quarter','Region'])['Profit'].sum().round(2).unstack().fillna(0)
running  = monthly.copy(); running['cumulative'] = running['sales'].cumsum()
scatter_df = df.groupby('Category').agg(sales=('Sales','sum'), profit=('Profit','sum'), orders=('Order ID','nunique')).reset_index()

# ── Colors ─────────────────────────────────────────────────────────────────────
BLUE  = '#2563EB'; RED   = '#DC2626'; GREEN = '#059669'
AMBER = '#D97706'; PURP  = '#7C3AED'; TEAL  = '#0D9488'
SLATE = '#1E293B'; GRAY  = '#64748B'; WHITE = '#FFFFFF'; BORDER = '#E2E8F0'
FONT  = 'Inter, Segoe UI, sans-serif'
NO_MB = {'displayModeBar': False}

# Chart base — no margin, auto height
B = dict(paper_bgcolor=WHITE, plot_bgcolor=WHITE,
         font=dict(family=FONT, color=SLATE, size=9),
         autosize=True)
DM = dict(l=8, r=8, t=28, b=8)  # default margin

def xa(grid=True): return dict(gridcolor=BORDER, linecolor=BORDER, tickfont=dict(color=GRAY, size=8), showgrid=grid)
def ya(pre='$', grid=True): return dict(gridcolor=BORDER, linecolor=BORDER, tickfont=dict(color=GRAY, size=8), tickprefix=pre, showgrid=grid)

# ── PAGE 1 CHARTS ──────────────────────────────────────────────────────────────
fig_trend = go.Figure()
fig_trend.add_trace(go.Scatter(x=monthly['Month'], y=monthly['sales'],
    fill='tozeroy', fillcolor='rgba(37,99,235,0.08)',
    line=dict(color=BLUE, width=1.5), name='Sales',
    hovertemplate='%{x}<br>$%{y:,.0f}<extra></extra>'))
fig_trend.add_trace(go.Scatter(x=monthly['Month'], y=monthly['profit'],
    line=dict(color=GREEN, width=1.5, dash='dot'), name='Profit',
    hovertemplate='%{x}<br>$%{y:,.0f}<extra></extra>'))
fig_trend.update_layout(**B, margin=DM,
    title=dict(text='Monthly Sales & Profit', font=dict(size=10, color=SLATE), x=0),
    legend=dict(orientation='h', y=1.18, x=1, xanchor='right', font=dict(size=8)))
fig_trend.update_xaxes(**xa(False), tickangle=45, nticks=12)
fig_trend.update_yaxes(**ya())

fig_yearly = go.Figure(go.Bar(
    x=yearly['Year'].astype(str), y=yearly['sales'],
    marker=dict(color=[BLUE,BLUE,BLUE,GREEN], line_width=0),
    text=[f'${v/1e6:.2f}M' for v in yearly['sales']],
    textposition='outside', textfont=dict(size=9), width=0.5))
fig_yearly.update_layout(**B, margin=DM,
    title=dict(text='Yearly Sales Growth', font=dict(size=10, color=SLATE), x=0), bargap=0.4)
fig_yearly.update_xaxes(**xa(False))
fig_yearly.update_yaxes(**ya())

# ── PAGE 2 CHARTS ──────────────────────────────────────────────────────────────
fig_cat_s = go.Figure(go.Bar(
    x=cat['Category'], y=cat['sales'],
    marker=dict(color=[BLUE,TEAL,PURP], line_width=0),
    text=[f'${v/1e3:.0f}K' for v in cat['sales']],
    textposition='outside', textfont=dict(size=9), width=0.5))
fig_cat_s.update_layout(**B, margin=DM,
    title=dict(text='Sales by Category', font=dict(size=10, color=SLATE), x=0), bargap=0.4)
fig_cat_s.update_xaxes(**xa(False))
fig_cat_s.update_yaxes(**ya())

fig_cat_p = go.Figure(go.Bar(
    x=cat['Category'], y=cat['profit'],
    marker=dict(color=[GREEN if v>0 else RED for v in cat['profit']], line_width=0),
    text=[f'${v/1e3:.0f}K' for v in cat['profit']],
    textposition='outside', textfont=dict(size=9), width=0.5))
fig_cat_p.update_layout(**B, margin=DM,
    title=dict(text='Profit by Category', font=dict(size=10, color=SLATE), x=0), bargap=0.4)
fig_cat_p.update_xaxes(**xa(False))
fig_cat_p.update_yaxes(**ya())

fig_sub = go.Figure(go.Bar(
    x=subcat['profit'], y=subcat['Sub-Category'], orientation='h',
    marker=dict(color=[RED if v<0 else BLUE for v in subcat['profit']], line_width=0),
    text=[f'${v:,.0f}' for v in subcat['profit']],
    textposition='outside', textfont=dict(size=8)))
fig_sub.update_layout(**B, margin=dict(l=8, r=50, t=28, b=8),
    title=dict(text='Sub-Category Profit — Red = Loss', font=dict(size=10, color=SLATE), x=0))
fig_sub.update_xaxes(**xa(), tickprefix='$')
fig_sub.update_yaxes(gridcolor='rgba(0,0,0,0)', linecolor=BORDER, tickfont=dict(color=SLATE, size=8), showgrid=False)

seg_c = [BLUE, GREEN, AMBER]
fig_scatter = go.Figure()
for i, row in scatter_df.iterrows():
    fig_scatter.add_trace(go.Scatter(
        x=[row['sales']], y=[row['profit']], mode='markers+text',
        marker=dict(size=row['orders']/20, color=seg_c[i], opacity=0.8, line=dict(width=1, color=WHITE)),
        text=[row['Category']], textposition='top center', textfont=dict(size=8),
        name=row['Category'],
        hovertemplate=f"<b>{row['Category']}</b><br>${row['sales']:,.0f}<br>${row['profit']:,.0f}<extra></extra>"))
fig_scatter.update_layout(**B, margin=DM, showlegend=False,
    title=dict(text='Sales vs Profit Bubble', font=dict(size=10, color=SLATE), x=0))
fig_scatter.update_xaxes(**xa(), tickprefix='$')
fig_scatter.update_yaxes(**ya())

# ── PAGE 3 CHARTS ──────────────────────────────────────────────────────────────
fig_reg_d = go.Figure(go.Pie(
    labels=reg['Region'], values=reg['sales'], hole=0.55,
