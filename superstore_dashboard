    hovertemplate='%{x}<br>$%{y:,.0f}<extra></extra>'))
fig_run.update_layout(**B, margin=DM,
    title=dict(text='Cumulative Sales Growth', font=dict(size=10, color=SLATE), x=0))
fig_run.update_xaxes(**xa(False), tickangle=45, nticks=12)
fig_run.update_yaxes(**ya())

fig_heat = go.Figure(go.Heatmap(
    z=qreg.values, x=qreg.columns.tolist(), y=qreg.index.tolist(),
    colorscale=[[0,'#FEE2E2'],[0.4,'#FEF9C3'],[0.7,'#DCFCE7'],[1,'#059669']],
    text=[[f'${v:,.0f}' for v in row] for row in qreg.values],
    texttemplate='<b>%{text}</b>', textfont=dict(size=7, family=FONT),
    showscale=True,
    colorbar=dict(tickfont=dict(color=GRAY, size=7), outlinewidth=0, len=0.8, thickness=8, tickprefix='$')))
fig_heat.update_layout(**B, margin=dict(l=8, r=50, t=28, b=8),
    title=dict(text='Quarterly Profit by Region', font=dict(size=10, color=SLATE), x=0))
fig_heat.update_xaxes(gridcolor='rgba(0,0,0,0)', linecolor=BORDER, tickfont=dict(color=SLATE, size=8), showgrid=False)
fig_heat.update_yaxes(gridcolor='rgba(0,0,0,0)', linecolor=BORDER, tickfont=dict(color=SLATE, size=7), showgrid=False)

