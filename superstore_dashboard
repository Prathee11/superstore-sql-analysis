fig_seg_d.update_layout(**B, margin=DM, showlegend=False,
    title=dict(text='Sales by Segment', font=dict(size=10, color=SLATE), x=0))

fig_reg_p = go.Figure(go.Bar(
    x=reg['Region'], y=reg['profit'],
    marker=dict(color=[BLUE,GREEN,AMBER,PURP], line_width=0),
    text=[f'${v/1e3:.0f}K' for v in reg['profit']],
    textposition='outside', textfont=dict(size=9), width=0.5))
fig_reg_p.update_layout(**B, margin=DM,
    title=dict(text='Profit by Region', font=dict(size=10, color=SLATE), x=0), bargap=0.4)
fig_reg_p.update_xaxes(**xa(False))
fig_reg_p.update_yaxes(**ya())

fig_cust = go.Figure(go.Bar(
    x=top_cust['profit'], y=top_cust['Customer Name'], orientation='h',
    marker=dict(color=BLUE, opacity=0.85, line_width=0),
    text=[f'${v:,.0f}' for v in top_cust['profit']],
